# Server-only SMTP settings. Never add VITE_ to these names.
# Gmail users should create a Google App Password instead of using their normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password

# Inbox that receives portfolio enquiries.
CONTACT_TO=your-email@gmail.com

# Must normally match SMTP_USER, especially when using Gmail.
CONTACT_FROM=your-email@gmail.com

# Optional SEO. On Vercel the production domain is detected automatically;
# set SITE_URL only to force a custom domain (no trailing slash).
SITE_URL=https://your-domain.com
# Optional: the content value of Google Search Console's HTML-tag verification.
GOOGLE_SITE_VERIFICATION=

# Optional: keeps the separate WhatsApp link visible when configured.
VITE_WHATSAPP_NUMBER=9198xxxxxxxx
